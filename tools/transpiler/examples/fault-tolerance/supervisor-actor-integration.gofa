// Supervisor-Actor Integration Example
// This demonstrates supervisors managing actors in a fault-tolerant system
package main

import (
	"context"
	"fmt"
	"log"
	"time"
)

// Root supervisor managing the entire application
@Supervisor("OneForAll", maxRetries: 2, retryInterval: "5s", escalate: false, fastInit: true)
func ApplicationSupervisor(ctx context.Context) {
	fmt.Println("Application Supervisor started - managing entire system")
	
	// Start subsystem supervisors
	go WebTierSupervisor(ctx)
	go DataTierSupervisor(ctx)
	go ProcessingTierSupervisor(ctx)
	
	<-ctx.Done()
	fmt.Println("Application Supervisor shutting down")
}

// Web tier supervisor managing web-related actors
@Supervisor("OneForOne", maxRetries: 5, retryInterval: "1s", escalate: true, parent: "ApplicationSupervisor")
func WebTierSupervisor(ctx context.Context) {
	fmt.Println("Web Tier Supervisor started - managing web actors")
	
	// Start web actors under supervision
	go HTTPHandlerActor(ctx)
	go WebSocketActor(ctx)
	go SessionActor(ctx)
	
	<-ctx.Done()
	fmt.Println("Web Tier Supervisor shutting down")
}

// Data tier supervisor managing data-related actors
@Supervisor("RestForOne", maxRetries: 3, retryInterval: "2s", escalate: true, parent: "ApplicationSupervisor")
func DataTierSupervisor(ctx context.Context) {
	fmt.Println("Data Tier Supervisor started - managing data actors")
	
	// Start data actors under supervision
	go DatabaseActor(ctx)
	go CacheActor(ctx)
	go SearchIndexActor(ctx)
	
	<-ctx.Done()
	fmt.Println("Data Tier Supervisor shutting down")
}

// Processing tier supervisor managing business logic actors
@Supervisor("OneForOne", maxRetries: 10, retryInterval: "500ms", escalate: true, parent: "ApplicationSupervisor")
func ProcessingTierSupervisor(ctx context.Context) {
	fmt.Println("Processing Tier Supervisor started - managing processing actors")
	
	// Start processing actors under supervision
	go OrderProcessingActor(ctx)
	go PaymentProcessingActor(ctx)
	go EmailActor(ctx)
	go ReportGeneratorActor(ctx)
	
	<-ctx.Done()
	fmt.Println("Processing Tier Supervisor shutting down")
}

// Web tier actors
@Actor(mailboxSize: 5000, poolSize: 20, timeout: "5s", supervised: true, supervisor: "WebTierSupervisor")
func HTTPHandlerActor(ctx context.Context) {
	fmt.Println("HTTP Handler Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("HTTP Handler Actor shutting down")
			return
		default:
			// Simulate HTTP request processing
			handleHTTPRequest()
			time.Sleep(10 * time.Millisecond)
		}
	}
}

@Actor(mailboxSize: 2000, poolSize: 10, timeout: "1s", supervised: true, supervisor: "WebTierSupervisor")
func WebSocketActor(ctx context.Context) {
	fmt.Println("WebSocket Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("WebSocket Actor shutting down")
			return
		default:
			// Simulate WebSocket message processing
			handleWebSocketMessage()
			time.Sleep(20 * time.Millisecond)
		}
	}
}

@Actor(mailboxSize: 1000, poolSize: 5, timeout: "30s", supervised: true, supervisor: "WebTierSupervisor")
func SessionActor(ctx context.Context) {
	fmt.Println("Session Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Session Actor shutting down")
			return
		default:
			// Simulate session management
			manageSession()
			time.Sleep(100 * time.Millisecond)
		}
	}
}

// Data tier actors
@Actor(mailboxSize: 3000, poolSize: 15, timeout: "10s", supervised: true, supervisor: "DataTierSupervisor")
func DatabaseActor(ctx context.Context) {
	fmt.Println("Database Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Database Actor shutting down")
			return
		default:
			// Simulate database operations
			performDatabaseOperation()
			time.Sleep(50 * time.Millisecond)
		}
	}
}

@Actor(mailboxSize: 8000, poolSize: 25, timeout: "2s", supervised: true, supervisor: "DataTierSupervisor")
func CacheActor(ctx context.Context) {
	fmt.Println("Cache Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Cache Actor shutting down")
			return
		default:
			// Simulate cache operations
			performCacheOperation()
			time.Sleep(5 * time.Millisecond)
		}
	}
}

@Actor(mailboxSize: 1500, poolSize: 8, timeout: "15s", supervised: true, supervisor: "DataTierSupervisor")
func SearchIndexActor(ctx context.Context) {
	fmt.Println("Search Index Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Search Index Actor shutting down")
			return
		default:
			// Simulate search indexing
			updateSearchIndex()
			time.Sleep(200 * time.Millisecond)
		}
	}
}

// Processing tier actors
@Actor(mailboxSize: 4000, poolSize: 30, timeout: "30s", supervised: true, supervisor: "ProcessingTierSupervisor")
func OrderProcessingActor(ctx context.Context) {
	fmt.Println("Order Processing Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Order Processing Actor shutting down")
			return
		default:
			// Simulate order processing
			processOrder()
			time.Sleep(100 * time.Millisecond)
		}
	}
}

@Actor(mailboxSize: 2000, poolSize: 20, timeout: "60s", supervised: true, supervisor: "ProcessingTierSupervisor")
func PaymentProcessingActor(ctx context.Context) {
	fmt.Println("Payment Processing Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Payment Processing Actor shutting down")
			return
		default:
			// Simulate payment processing
			processPayment()
			time.Sleep(500 * time.Millisecond)
		}
	}
}

@Actor(mailboxSize: 6000, poolSize: 12, timeout: "10s", supervised: true, supervisor: "ProcessingTierSupervisor")
func EmailActor(ctx context.Context) {
	fmt.Println("Email Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Email Actor shutting down")
			return
		default:
			// Simulate email sending
			sendEmail()
			time.Sleep(300 * time.Millisecond)
		}
	}
}

@Actor(mailboxSize: 1000, poolSize: 5, timeout: "120s", supervised: true, supervisor: "ProcessingTierSupervisor")
func ReportGeneratorActor(ctx context.Context) {
	fmt.Println("Report Generator Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Report Generator Actor shutting down")
			return
		default:
			// Simulate report generation
			generateReport()
			time.Sleep(5 * time.Second)
		}
	}
}

// Simulation functions for different types of work
func handleHTTPRequest() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("HTTP request handling failed: %v", r)
		}
	}()
	
	// Simulate HTTP request processing
	if time.Now().Unix()%100 == 0 {
		panic("HTTP handler connection refused")
	}
}

func handleWebSocketMessage() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("WebSocket message handling failed: %v", r)
		}
	}()
	
	// Simulate WebSocket message processing
	if time.Now().Unix()%150 == 0 {
		panic("WebSocket connection dropped")
	}
}

func manageSession() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Session management failed: %v", r)
		}
	}()
	
	// Simulate session management
	if time.Now().Unix()%200 == 0 {
		panic("Session store unavailable")
	}
}

func performDatabaseOperation() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Database operation failed: %v", r)
		}
	}()
	
	// Simulate database operations
	if time.Now().Unix()%80 == 0 {
		panic("Database connection timeout")
	}
}

func performCacheOperation() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Cache operation failed: %v", r)
		}
	}()
	
	// Simulate cache operations
	if time.Now().Unix()%300 == 0 {
		panic("Cache cluster unreachable")
	}
}

func updateSearchIndex() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Search index update failed: %v", r)
		}
	}()
	
	// Simulate search index operations
	if time.Now().Unix()%120 == 0 {
		panic("Search index corruption detected")
	}
}

func processOrder() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Order processing failed: %v", r)
		}
	}()
	
	// Simulate order processing
	if time.Now().Unix()%90 == 0 {
		panic("Order validation failed")
	}
}

func processPayment() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Payment processing failed: %v", r)
		}
	}()
	
	// Simulate payment processing
	if time.Now().Unix()%60 == 0 {
		panic("Payment gateway error")
	}
}

func sendEmail() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Email sending failed: %v", r)
		}
	}()
	
	// Simulate email sending
	if time.Now().Unix()%180 == 0 {
		panic("SMTP server unavailable")
	}
}

func generateReport() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Report generation failed: %v", r)
		}
	}()
	
	// Simulate report generation
	if time.Now().Unix()%400 == 0 {
		panic("Report generation out of memory")
	}
}

// Critical system monitoring - runs independently
@Supervisor("OneForOne", maxRetries: 1, retryInterval: "100ms", escalate: true, fastInit: true)
func CriticalMonitoringSupervisor(ctx context.Context) {
	fmt.Println("Critical Monitoring Supervisor started")
	
	go SystemHealthActor(ctx)
	go SecurityAuditActor(ctx)
	
	<-ctx.Done()
	fmt.Println("Critical Monitoring Supervisor shutting down")
}

@Actor(mailboxSize: 100, poolSize: 2, timeout: "1s", supervised: true, supervisor: "CriticalMonitoringSupervisor")
func SystemHealthActor(ctx context.Context) {
	fmt.Println("System Health Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("System Health Actor shutting down")
			return
		default:
			// Monitor system health
			monitorSystemHealth()
			time.Sleep(1 * time.Second)
		}
	}
}

@Actor(mailboxSize: 500, poolSize: 3, timeout: "2s", supervised: true, supervisor: "CriticalMonitoringSupervisor")
func SecurityAuditActor(ctx context.Context) {
	fmt.Println("Security Audit Actor started")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("Security Audit Actor shutting down")
			return
		default:
			// Perform security auditing
			performSecurityAudit()
			time.Sleep(2 * time.Second)
		}
	}
}

func monitorSystemHealth() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("CRITICAL: System health monitoring failed: %v", r)
		}
	}()
	
	// Simulate system health monitoring
	if time.Now().Unix()%500 == 0 {
		panic("System health check failed")
	}
}

func performSecurityAudit() {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("CRITICAL: Security audit failed: %v", r)
		}
	}()
	
	// Simulate security auditing
	if time.Now().Unix()%600 == 0 {
		panic("Security audit system failure")
	}
}

func main() {
	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
	defer cancel()
	
	fmt.Println("Starting Supervisor-Actor Integration Example")
	fmt.Println("Demonstrating hierarchical fault tolerance with supervised actors")
	fmt.Println("Architecture: Application -> Tier Supervisors -> Actor Groups")
	
	// Start the main application supervisor (manages everything)
	go ApplicationSupervisor(ctx)
	
	// Start critical monitoring independently (shouldn't bring down main app)
	go CriticalMonitoringSupervisor(ctx)
	
	// Let the system run and demonstrate fault tolerance
	fmt.Println("\nSystem running... watch for failures and automatic restarts")
	
	<-ctx.Done()
	fmt.Println("\nSupervisor-Actor Integration Example completed")
	fmt.Println("All supervised actors should have been gracefully restarted on failures")
}