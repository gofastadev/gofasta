// Advanced Actor System Example
// This demonstrates complex actor interactions with supervision
package actorsystem

import (
	"context"
	"fmt"
	"log"
	"sync"
	"time"
)

// Complex message types
type OrderMessage struct {
	OrderID     string
	CustomerID  string
	Products    []Product
	TotalAmount float64
}

type Product struct {
	ID       string
	Name     string
	Price    float64
	Quantity int
}

type InventoryMessage struct {
	ProductID string
	Quantity  int
	Operation string // "reserve", "release", "check"
}

type NotificationMessage struct {
	RecipientID string
	Type        string
	Subject     string
	Body        string
	Priority    int
}

// Order processing actor - high-throughput, supervised
@Actor(mailboxSize: 5000, poolSize: 30, timeout: "2s", supervised: true, supervisor: "OrderSupervisor")
func OrderProcessorActor(ctx context.Context) {
	fmt.Println("OrderProcessorActor started - processing e-commerce orders")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("OrderProcessorActor shutting down")
			return
		default:
			order := receiveOrderMessage()
			if order != nil {
				processOrder(order)
			}
			time.Sleep(5 * time.Millisecond)
		}
	}
}

// Inventory management actor - reliable, memory pooled
@Actor(mailboxSize: 2000, poolSize: 15, timeout: "1s", supervised: true, supervisor: "InventorySupervisor")
func InventoryActor(ctx context.Context) {
	fmt.Println("InventoryActor started - managing product inventory")
	
	// In-memory inventory state (would be backed by database in real system)
	inventory := make(map[string]int)
	var mu sync.RWMutex
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("InventoryActor shutting down")
			return
		default:
			inventoryMsg := receiveInventoryMessage()
			if inventoryMsg != nil {
				processInventoryMessage(inventoryMsg, inventory, &mu)
			}
			time.Sleep(10 * time.Millisecond)
		}
	}
}

// Payment processing actor - critical, supervised with fast restart
@Actor(mailboxSize: 1000, poolSize: 20, timeout: "5s", supervised: true, supervisor: "PaymentSupervisor")
func PaymentProcessorActor(ctx context.Context) {
	fmt.Println("PaymentProcessorActor started - processing payments")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("PaymentProcessorActor shutting down")
			return
		default:
			order := receiveOrderMessage()
			if order != nil {
				processPayment(order)
			}
			time.Sleep(50 * time.Millisecond)
		}
	}
}

// Notification actor - high-volume, memory optimized
@Actor(mailboxSize: 10000, poolSize: 10, timeout: "500ms", supervised: false)
func NotificationActor(ctx context.Context) {
	fmt.Println("NotificationActor started - sending notifications")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("NotificationActor shutting down")
			return
		default:
			notification := receiveNotificationMessage()
			if notification != nil {
				sendNotification(notification)
			}
			time.Sleep(2 * time.Millisecond)
		}
	}
}

// Analytics actor - batch processing, large memory pool
@Actor(mailboxSize: 8000, poolSize: 25, timeout: "30s", supervised: true, supervisor: "AnalyticsSupervisor")
func AnalyticsActor(ctx context.Context) {
	fmt.Println("AnalyticsActor started - processing analytics data")
	
	batch := make([]interface{}, 0, 500)
	ticker := time.NewTicker(10 * time.Second)
	defer ticker.Stop()
	
	for {
		select {
		case <-ctx.Done():
			// Process final batch
			if len(batch) > 0 {
				processAnalyticsBatch(batch)
			}
			fmt.Println("AnalyticsActor shutting down")
			return
		case <-ticker.C:
			// Process batch periodically
			if len(batch) > 0 {
				processAnalyticsBatch(batch)
				batch = batch[:0]
			}
		default:
			// Collect data for analytics
			data := receiveAnalyticsData()
			if data != nil {
				batch = append(batch, data)
				
				// Process when batch is full
				if len(batch) >= 500 {
					processAnalyticsBatch(batch)
					batch = batch[:0]
				}
			}
			time.Sleep(20 * time.Millisecond)
		}
	}
}

// Fraud detection actor - real-time, unsupervised critical actor
@Actor(mailboxSize: 500, poolSize: 5, timeout: "50ms", supervised: false)
func FraudDetectionActor(ctx context.Context) {
	fmt.Println("FraudDetectionActor started - real-time fraud detection")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("FraudDetectionActor shutting down")
			return
		default:
			order := receiveOrderMessage()
			if order != nil {
				checkForFraud(order)
			}
		}
	}
}

// Customer service actor - human-scale processing
@Actor(mailboxSize: 200, poolSize: 8, timeout: "10s", supervised: true, supervisor: "CustomerServiceSupervisor")
func CustomerServiceActor(ctx context.Context) {
	fmt.Println("CustomerServiceActor started - handling customer requests")
	
	for {
		select {
		case <-ctx.Done():
			fmt.Println("CustomerServiceActor shutting down")
			return
		default:
			request := receiveCustomerRequest()
			if request != nil {
				handleCustomerRequest(request)
			}
			time.Sleep(100 * time.Millisecond)
		}
	}
}

// Message receiving functions (simulate message queues)
func receiveOrderMessage() *OrderMessage {
	if time.Now().UnixNano()%1000000 < 300000 { // 30% chance
		return &OrderMessage{
			OrderID:    fmt.Sprintf("ORDER-%d", time.Now().UnixNano()),
			CustomerID: fmt.Sprintf("CUST-%d", time.Now().Unix()%10000),
			Products: []Product{
				{ID: "PROD-1", Name: "Widget", Price: 29.99, Quantity: 2},
				{ID: "PROD-2", Name: "Gadget", Price: 49.99, Quantity: 1},
			},
			TotalAmount: 109.97,
		}
	}
	return nil
}

func receiveInventoryMessage() *InventoryMessage {
	if time.Now().UnixNano()%1000000 < 200000 { // 20% chance
		operations := []string{"reserve", "release", "check"}
		products := []string{"PROD-1", "PROD-2", "PROD-3", "PROD-4"}
		
		return &InventoryMessage{
			ProductID: products[time.Now().Unix()%int64(len(products))],
			Quantity:  int(time.Now().Unix()%10) + 1,
			Operation: operations[time.Now().Unix()%int64(len(operations))],
		}
	}
	return nil
}

func receiveNotificationMessage() *NotificationMessage {
	if time.Now().UnixNano()%1000000 < 400000 { // 40% chance
		types := []string{"email", "sms", "push", "webhook"}
		priorities := []int{1, 2, 3, 4, 5}
		
		return &NotificationMessage{
			RecipientID: fmt.Sprintf("USER-%d", time.Now().Unix()%1000),
			Type:        types[time.Now().Unix()%int64(len(types))],
			Subject:     "Order Update",
			Body:        "Your order status has been updated",
			Priority:    priorities[time.Now().Unix()%int64(len(priorities))],
		}
	}
	return nil
}

func receiveAnalyticsData() interface{} {
	if time.Now().UnixNano()%1000000 < 150000 { // 15% chance
		return map[string]interface{}{
			"event_type": "page_view",
			"user_id":    fmt.Sprintf("USER-%d", time.Now().Unix()%1000),
			"timestamp":  time.Now().Unix(),
			"properties": map[string]string{
				"page": "/products",
				"referrer": "google.com",
			},
		}
	}
	return nil
}

func receiveCustomerRequest() interface{} {
	if time.Now().UnixNano()%1000000 < 100000 { // 10% chance
		return map[string]interface{}{
			"request_id":   fmt.Sprintf("REQ-%d", time.Now().UnixNano()),
			"customer_id":  fmt.Sprintf("CUST-%d", time.Now().Unix()%1000),
			"type":         "support",
			"priority":     "medium",
			"description":  "Need help with order tracking",
		}
	}
	return nil
}

// Message processing functions
func processOrder(order *OrderMessage) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Order processing failed for %s: %v", order.OrderID, r)
		}
	}()
	
	fmt.Printf("Processing order %s for customer %s\n", order.OrderID, order.CustomerID)
	
	// Simulate processing steps
	time.Sleep(10 * time.Millisecond)
	
	// Simulate occasional failures
	if time.Now().Unix()%100 == 0 {
		panic("Order validation failed")
	}
	
	fmt.Printf("Order %s processed successfully\n", order.OrderID)
}

func processInventoryMessage(msg *InventoryMessage, inventory map[string]int, mu *sync.RWMutex) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Inventory operation failed for %s: %v", msg.ProductID, r)
		}
	}()
	
	switch msg.Operation {
	case "reserve":
		mu.Lock()
		if inventory[msg.ProductID] >= msg.Quantity {
			inventory[msg.ProductID] -= msg.Quantity
			fmt.Printf("Reserved %d units of %s\n", msg.Quantity, msg.ProductID)
		} else {
			fmt.Printf("Insufficient inventory for %s\n", msg.ProductID)
		}
		mu.Unlock()
	case "release":
		mu.Lock()
		inventory[msg.ProductID] += msg.Quantity
		fmt.Printf("Released %d units of %s\n", msg.Quantity, msg.ProductID)
		mu.Unlock()
	case "check":
		mu.RLock()
		current := inventory[msg.ProductID]
		mu.RUnlock()
		fmt.Printf("Current inventory for %s: %d units\n", msg.ProductID, current)
	}
	
	// Simulate database failures
	if time.Now().Unix()%80 == 0 {
		panic("Inventory database connection lost")
	}
}

func processPayment(order *OrderMessage) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Payment processing failed for %s: %v", order.OrderID, r)
		}
	}()
	
	fmt.Printf("Processing payment of $%.2f for order %s\n", order.TotalAmount, order.OrderID)
	
	// Simulate payment gateway interaction
	time.Sleep(100 * time.Millisecond)
	
	// Simulate payment failures
	if time.Now().Unix()%50 == 0 {
		panic("Payment gateway timeout")
	}
	
	fmt.Printf("Payment processed successfully for order %s\n", order.OrderID)
}

func sendNotification(notification *NotificationMessage) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Notification failed for %s: %v", notification.RecipientID, r)
		}
	}()
	
	fmt.Printf("Sending %s notification to %s (Priority: %d)\n", 
		notification.Type, notification.RecipientID, notification.Priority)
	
	// Simulate sending with priority-based delay
	delay := time.Duration(6-notification.Priority) * time.Millisecond
	time.Sleep(delay)
	
	// Simulate notification service failures
	if time.Now().Unix()%200 == 0 {
		panic("Notification service unavailable")
	}
}

func processAnalyticsBatch(batch []interface{}) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Analytics batch processing failed: %v", r)
		}
	}()
	
	fmt.Printf("Processing analytics batch of %d events\n", len(batch))
	
	// Simulate batch analytics processing
	time.Sleep(time.Duration(len(batch)) * time.Millisecond)
	
	// Simulate analytics processing failures
	if time.Now().Unix()%120 == 0 {
		panic("Analytics processing out of memory")
	}
}

func checkForFraud(order *OrderMessage) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Fraud check failed for %s: %v", order.OrderID, r)
		}
	}()
	
	// High-speed fraud detection
	if order.TotalAmount > 1000 {
		fmt.Printf("High-value order detected: %s ($%.2f)\n", order.OrderID, order.TotalAmount)
	}
	
	// Simulate fraud detection processing
	// No artificial delays for real-time processing
	
	// Simulate rare fraud detection failures
	if time.Now().Unix()%300 == 0 {
		panic("Fraud detection model unavailable")
	}
}

func handleCustomerRequest(request interface{}) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Customer service request failed: %v", r)
		}
	}()
	
	requestMap := request.(map[string]interface{})
	fmt.Printf("Handling customer request %s\n", requestMap["request_id"])
	
	// Simulate human-scale processing time
	time.Sleep(2 * time.Second)
	
	// Simulate customer service system failures
	if time.Now().Unix()%150 == 0 {
		panic("Customer service database timeout")
	}
}

func main() {
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()
	
	fmt.Println("Starting Advanced Actor System Example")
	fmt.Println("Simulating e-commerce platform with multiple actor types")
	
	// Start all actors
	go OrderProcessorActor(ctx)
	go InventoryActor(ctx)
	go PaymentProcessorActor(ctx)
	go NotificationActor(ctx)
	go AnalyticsActor(ctx)
	go FraudDetectionActor(ctx)
	go CustomerServiceActor(ctx)
	
	// Let the system run
	<-ctx.Done()
	fmt.Println("Advanced Actor System Example completed")
}