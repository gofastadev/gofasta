	defer func() {
		if r := recover(); r != nil {
			log.Printf("WebSocket server failed: %v", r)
		}
	}()
	
	for {
		select {
		case <-ctx.Done():
			return
		default:
			time.Sleep(20 * time.Millisecond)
			if time.Now().Unix()%35 == 0 {
				panic("WebSocket upgrade failed")
			}
		}
	}
}

