	defer func() {
		if r := recover(); r != nil {
			log.Printf("Health check server failed: %v", r)
		}
	}()
	
	for {
		select {
		case <-ctx.Done():
			return
		default:
			time.Sleep(1000 * time.Millisecond)
			if time.Now().Unix()%60 == 0 {
				panic("Health check endpoint failed")
			}
		}
	}
