// Background job functions
func emailWorker(ctx context.Context) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Email worker failed: %v", r)
		}
	}()
	
	for {
		select {
		case <-ctx.Done():
			return
		default:
			time.Sleep(2000 * time.Millisecond)
			if time.Now().Unix()%50 == 0 {
				panic("SMTP server unreachable")
			}
		}
	}
}

func reportGenerator(ctx context.Context) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Report generator failed: %v", r)
		}
	}()
	
	for {
		select {
		case <-ctx.Done():
			return
		default:
			time.Sleep(5000 * time.Millisecond)
			if time.Now().Unix()%80 == 0 {
				panic("Report generation out of memory")
			}
		}
	}
}

func dataCleanupWorker(ctx context.Context) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Data cleanup worker failed: %v", r)
		}
	}()
	
	for {
		select {
		case <-ctx.Done():
			return
		default:
			time.Sleep(10000 * time.Millisecond)
			if time.Now().Unix()%100 == 0 {
				panic("Cleanup process disk full")
			}
		}
	}
}

// Critical system functions
func securityMonitor(ctx context.Context) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("CRITICAL: Security monitor failed: %v", r)
		}
	}()
	
	for {
		select {
		case <-ctx.Done():
			return
		default:
			time.Sleep(100 * time.Millisecond)
			if time.Now().Unix()%200 == 0 {
				panic("Security breach detected")
			}
		}
	}
}

func systemHealthMonitor(ctx context.Context) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("CRITICAL: System health monitor failed: %v", r)
		}
	}()
	
	for {
		select {
		case <-ctx.Done():
			return
		default:
			time.Sleep(500 * time.Millisecond)
			if time.Now().Unix()%150 == 0 {
				panic("System resources exhausted")
			}
		}
	}
}

func auditLogger(ctx context.Context) {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("CRITICAL: Audit logger failed: %v", r)
		}
	}()
	
	for {
		select {
		case <-ctx.Done():
			return
		default:
			time.Sleep(50 * time.Millisecond)
			if time.Now().Unix()%180 == 0 {
				panic("Audit log storage full")
			}
		}
	}
}

func main() {
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()
	
	fmt.Println("Starting Advanced Hierarchical Supervisor Example")
	
	// Start root supervisor which manages the entire hierarchy
	go RootSupervisor(ctx)
	
	// Start critical system supervisor independently
	go CriticalSystemSupervisor(ctx)
	
	// Wait for completion
	<-ctx.Done()
	fmt.Println("Advanced Supervisor Example completed")
}