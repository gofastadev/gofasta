package main

// Comprehensive demonstration of @ConnectedSocket() parameter decorator
// Shows how to access the current WebSocket client connection in various contexts

// Basic WebSocket Gateway
@WebSocketGateway({
	port: 3000,
	namespace: "/chat",
	cors: true
})
type ChatGateway struct {
	@Inject("chatService")
	chatService *ChatService
	
	@Inject("userService") 
	userService *UserService
}

// === CONNECTION LIFECYCLE EXAMPLES ===

// Access client during connection establishment
@OnGatewayConnection()
func HandleNewConnection(
	@ConnectedSocket() client *WebSocketClient,
