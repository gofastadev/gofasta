// Multiple parameter decorators with ConnectedSocket
@SubscribeMessage("join_room")
func HandleJoinRoom(
	@MessageBody() roomData *JoinRoomData,
	@ConnectedSocket() client *WebSocketClient,
	@CurrentUser() user *User,
	@MessageAck() ack *AckCallback
) {
	// Validate user can join room
	if !canJoinRoom(user, roomData.RoomID) {
		// ack.Error("Permission denied")
		return
	}
	
	// Use client to join room
	// client.Join(roomData.RoomID)
	
	// Notify other users in room
