// === MULTIPLE PARAMETER DECORATORS ===

// Example combining @ConnectedSocket() with other decorators
// @ConnectedSocket() provides the WebSocket client
// @MessageBody() provides the message payload  
// @CurrentUser() provides authenticated user (from authentication middleware)
// @MessageAck() provides callback for response acknowledgment
@SubscribeMessage("user_action")
func HandleUserAction(
	@MessageBody() action *UserAction,
	@ConnectedSocket() client *WebSocketClient,
	@CurrentUser() user *User,
	@MessageAck() ack *AckCallback
) {
	// You can use multiple parameter decorators together
	// Access client and user information
	// clientID := client.ID()
	// userID := user.ID
	
	// Process the action
	if action.Type == "ping" {
		// ack.Success("pong")
	} else {
		// ack.Error("Unknown action type")
	}
	
	// Optionally broadcast the action
	// client.Broadcast().Emit("user_action", map[string]interface{}{
	//     "userID": userID,
	//     "clientID": clientID,
	//     "action": action.Type,
	// })
}

// === ERROR HANDLING ===

// Example with error handling using client
@SubscribeMessage("risky_operation")
func HandleRiskyOperation(
	@MessageBody() data *OperationData,
	@ConnectedSocket() client *WebSocketClient
) {
	// Perform operation that might fail
	err := performRiskyOperation(data)
	
	if err != nil {
		// Send error back to the specific client
		// client.Emit("operation_error", map[string]interface{}{
		//     "error": err.Error(),
		//     "operation": data.Type,
		// })
		return
	}
	
	// Send success response
	// client.Emit("operation_success", map[string]interface{}{
	//     "result": "Operation completed successfully",
	//     "operation": data.Type,
	// })
}

// === HELPER FUNCTIONS ===

func performRiskyOperation(data *OperationData) error {
	// Simulate an operation that might fail
	if data.Type == "fail" {
		return fmt.Errorf("operation failed")
	}
	return nil
}

// === DATA STRUCTURES ===

type RoomMessageData struct {
	RoomName string `json:"room_name"`
	Message  string `json:"message"`
}

type UserAction struct {
	Type string      `json:"type"`
	Data interface{} `json:"data"`
}

type OperationData struct {
	Type   string      `json:"type"`
	Params interface{} `json:"params"`
}

type User struct {
	ID   string `json:"id"`
	Name string `json:"name"`
}

// === SERVICES ===

@Injectable()
type MessageService struct{}

// === WEBSOCKET TYPES ===

type WebSocketClient struct {
	id string
}

type AckCallback struct{}