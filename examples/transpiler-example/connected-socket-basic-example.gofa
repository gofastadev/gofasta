package main

import "fmt"

// Simple example demonstrating @ConnectedSocket() parameter decorator basics
// Perfect for beginners learning WebSocket parameter decorators

@WebSocketGateway(3000)
type SimpleWebSocketGateway struct {
	@Inject("messageService")
	messageService *MessageService
}

// === BASIC CONNECTION LIFECYCLE ===

// Handle new client connections
@OnGatewayConnection()
func OnClientConnect(@ConnectedSocket() client *WebSocketClient) {
	// The @ConnectedSocket() decorator injects the current WebSocket client
	// You can use it to:
	// - Get client ID: client.ID()
	// - Send messages: client.Emit()
	// - Join rooms: client.Join()
	// - Access client properties
	
	// Get client ID for logging or processing
	// clientID := client.ID()
	// Welcome the connected client
	// client.Emit("welcome", "Hello! Your client ID is: " + clientID)
}

// Handle client disconnections
@OnGatewayDisconnect()
func OnClientDisconnect(@ConnectedSocket() client *WebSocketClient) {
	// Access client information before they disconnect
	// clientID := client.ID()
	
	// Log or cleanup based on client ID
	// logDisconnection(clientID)
}

// === BASIC MESSAGE HANDLING ===

// Simple echo server - send message back to sender
@SubscribeMessage("echo")
func HandleEcho(
	@MessageBody() message string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Send the message back to the same client that sent it
	// client.Emit("echo_response", "You said: " + message)
}

// Broadcast message to all clients
@SubscribeMessage("broadcast")
func HandleBroadcast(
	@MessageBody() message string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Get sender's client ID
	// senderID := client.ID()
	
	// Broadcast to all clients (including sender)
	// client.Broadcast().Emit("broadcast_message", map[string]interface{}{
	//     "sender": senderID,
	//     "message": message,
	// })
}

// Send message to all clients except sender
@SubscribeMessage("announce")
func HandleAnnounce(
	@MessageBody() announcement string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Broadcast to all clients EXCEPT the sender
	// client.Broadcast().Emit("announcement", announcement)
}

