	// Electronic product trait with warranty and specifications
}

@Trait("book")
func BookProduct() *Product {
	// Book product trait with author, ISBN, and genre
}

@Trait("clothing")
func ClothingProduct() *Product {
	// Clothing product trait with size, color, and material
}

@Trait("digital")
func DigitalProduct() *Product {
	// Digital product trait with download link and license
}