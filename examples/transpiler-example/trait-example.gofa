package main

// Factory with multiple traits for creating different types of users
@Factory()
type UserFactory struct {
	@Inject("database")
	db *Database
	
	@Inject("logger")
	logger *Logger
}

@Trait("admin")
func AdminUser() *User {
	// Create admin user with special privileges
}

@Trait("premium")
func PremiumUser() *User {
	// Create premium user with enhanced features  
}

@Trait("guest")
func GuestUser() *User {
	// Create guest user with limited access
}

@Trait("moderator")
func ModeratorUser() *User {
	// Create moderator user with moderation capabilities
}

// Factory for creating different product types
