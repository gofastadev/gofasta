package main

// ✅ @ValidateIf is now fully implemented!
// It supports conditional validation decorators based on field values

@Injectable()
type ConditionalValidationDto struct {
    // Required field to determine validation path
    @IsNotEmpty()
    UserType string             // "individual" or "business"
    
    // Conditional validation for individual users
    @ValidateIf("dto.UserType == \"individual\"")
    @IsNotEmpty()
    @MinLength(2)
    @MaxLength(50)
    PersonalName string         // Required only for individual users
    
    // Conditional validation for business users
    @ValidateIf("dto.UserType == \"business\"") 
    @IsNotEmpty()
    @MinLength(3)
    @MaxLength(100)
    CompanyName string          // Required only for business users
    
    // Age validation only for individuals
    @ValidateIf("dto.UserType == \"individual\"")
    @Min(18)
    @Max(120)
    Age int                     // Required only for individual users
    
    // Business registration number only for businesses
    @ValidateIf("dto.UserType == \"business\"")
    @IsNotEmpty()
    @Matches("^[A-Z0-9]{8,12}$")
    BusinessRegNumber string    // Required only for business users
    
    // Complex conditional validation
    @ValidateIf("dto.UserType == \"individual\"")
    @IsOptional()
    @IsEmail()
    PersonalEmail string        // Optional email for individuals
    
    @ValidateIf("dto.UserType == \"business\"")
    @IsEmail()
    BusinessEmail string        // Required email for businesses
}

@Injectable()
type ValidationService struct {
}

func (s *ValidationService) validateUser(dto ConditionalValidationDto) {
    // ✅ Conditional validation is now handled automatically by @ValidateIf()!
    // The generated ValidateConditionalValidationDto() function will:
    // - Only validate PersonalName if UserType == "individual"
    // - Only validate CompanyName and BusinessRegNumber if UserType == "business"  
    // - Only validate Age if UserType == "individual"
    // - Handle complex nested conditional logic automatically
}

@Controller("/api/users")
type UserController struct {
    service *ValidationService `inject:""`
}

@Post("/validate")
func (c *UserController) validateUser(@Body() user ConditionalValidationDto) {
    c.service.validateUser(user)
}