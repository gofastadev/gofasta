package main

import "fmt"

// Comprehensive demonstration of @MessageAck() parameter decorator
// Advanced acknowledgment patterns for reliable WebSocket messaging

@WebSocketGateway({
	port: 3000,
	namespace: "/reliable",
	cors: true
})
type ReliableMessagingGateway struct {
	@Inject("messageService")
	messageService *MessageService
	
	@Inject("auditService")
	auditService *AuditService
}

// === TRANSACTIONAL MESSAGING ===

// Database transaction with acknowledgment
@SubscribeMessage("create_order")
