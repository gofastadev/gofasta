package main

// Example demonstrating @ValidateNested() for various nested struct scenarios

@Injectable()
type UserProfileDto struct {
    @IsNotEmpty()
    @MinLength(2)
    @MaxLength(50)
    FirstName string
    
    @IsNotEmpty()
    @MinLength(2)
    @MaxLength(50)
    LastName string
    
    @IsPositive()
    @Min(13)
    @Max(120)
    Age int
}

@Injectable()
type AddressDto struct {
    @IsNotEmpty()
    @MinLength(5)
    Street string
    
    @IsNotEmpty()
    @MinLength(2)
    City string
    
    @IsNotEmpty()
    @MinLength(2)
    @MaxLength(10)
    ZipCode string
    
    @IsNotEmpty()
    @Length(2, 3)
    Country string
}

@Injectable()
type ContactInfoDto struct {
    @IsEmail()
    Email string
    
    @IsOptional()
    @IsPhoneNumber()
    Phone string
    
    @IsOptional()
    @IsURL()
    Website string
}

@Injectable()
type NestedUserDto struct {
    // Direct nested struct validation
    @ValidateNested()
    Profile UserProfileDto
    
    // Direct nested struct validation 
    @ValidateNested()
    Address AddressDto
    
    // Optional nested struct validation
    @IsOptional()
    @ValidateNested()
    Contact ContactInfoDto
    
    // Pointer to struct validation
    @ValidateNested()
    BillingAddress *AddressDto
    
    // Optional pointer to struct validation
    @IsOptional()
    @ValidateNested()
    ShippingAddress *AddressDto
    
    // Slice of structs validation
    @ValidateNested()
    @ArrayMinSize(1)
    Addresses []AddressDto
    
    // Optional slice validation
    @IsOptional()
    @ValidateNested()
    PreviousAddresses []AddressDto
    
    // Slice of pointers validation
    @ValidateNested()
    @ArrayMinSize(1)
    References []*ContactInfoDto
    
    // Complex nested validation
    @ValidateNested()
    PrimaryContact ContactInfoDto
}

@Controller("/api/users")
type UserController struct {
}

@Post("/nested")
func (c *UserController) createNestedUser(@Body() user NestedUserDto) {
    // Generated validation will handle all nested validation automatically
}