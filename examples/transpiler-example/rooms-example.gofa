// === DATA STRUCTURES ===

type HierarchicalMessage struct {
	Content string `json:"content"`
	Level   int    `json:"level"`
	Type    string `json:"type"`
}

type CoordinationRequest struct {
	Action      string   `json:"action"`
	TargetRooms []string `json:"target_rooms"`
	Timeout     int      `json:"timeout"`
}

type ApprovalWorkflow struct {
	Title         string   `json:"title"`
	Description   string   `json:"description"`
	RequiredRooms []string `json:"required_rooms"`
	Deadline      string   `json:"deadline"`
}

type VoteRequest struct {
	Question    string   `json:"question"`
	Options     []string `json:"options"`
	TargetRooms []string `json:"target_rooms,omitempty"`
	Deadline    string   `json:"deadline"`
	Anonymous   bool     `json:"anonymous"`
}

type OptimizationPreferences struct {
	MaxRooms      int      `json:"max_rooms"`
	Categories    []string `json:"categories"`
	ActivityLevel string   `json:"activity_level"`
}

type MonitoringConfig struct {
	Duration   int      `json:"duration"`
	Alerts     []string `json:"alerts"`
}

// === SERVICES ===

@Injectable()
type RoomManager struct{}

// === TYPES ===

type User struct {
	ID   string `json:"id"`
	Name string `json:"name"`
	Role string `json:"role"`
}

type WebSocketClient struct {
	id string
}

type AckCallback struct{}