// Cross-room coordination with room state tracking
@SubscribeMessage("coordinate_across_rooms")
func HandleCrossRoomCoordination(
	@MessageBody() coordination *CoordinationRequest,
	@Rooms() participantRooms []string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Find intersection of requested rooms and participant rooms
	eligibleRooms := make([]string, 0)
	
	for _, requested := range coordination.TargetRooms {
		for _, participant := range participantRooms {
			if requested == participant {
				eligibleRooms = append(eligibleRooms, requested)
				break
			}
		}
	}
	
	if len(eligibleRooms) == 0 {
		// client.Emit("coordination_error", "No eligible rooms for coordination")
		return
	}
	
	// Initiate coordination across eligible rooms
	coordinationID := generateCoordinationID()
	
	for _, roomName := range eligibleRooms {
		// client.To(roomName).Emit("coordination_request", coordinationID)
	}
	
	// Track coordination state
	// trackCoordination(coordinationID, eligibleRooms, coordination.Action)
}

// === ROOM-BASED WORKFLOWS ===

// Multi-room approval workflow
@SubscribeMessage("start_approval_workflow")
func HandleApprovalWorkflow(
	@MessageBody() workflow *ApprovalWorkflow,
	@Rooms() availableRooms []string,
	@CurrentUser() user *User
) {
	// Validate workflow rooms against available rooms
	workflowRooms := make([]string, 0)
	missingRooms := make([]string, 0)
	
	for _, required := range workflow.RequiredRooms {
		found := false
		for _, available := range availableRooms {
			if required == available {
				workflowRooms = append(workflowRooms, required)
				found = true
				break
			}
		}
		if !found {
			missingRooms = append(missingRooms, required)
		}
	}
	
	if len(missingRooms) > 0 {
		// client.Emit("workflow_error", "Missing access to required rooms")
		return
	}
	
	// Start approval workflow across all required rooms
	workflowID := generateWorkflowID()
	
	for _, roomName := range workflowRooms {
		// client.To(roomName).Emit("approval_request", workflowID)
	}
	
	// Initialize workflow state
	// initializeWorkflow(workflowID, workflowRooms, user.ID)
}

// Room-based voting system
@SubscribeMessage("initiate_vote")
func HandleInitiateVote(
	@MessageBody() vote *VoteRequest,
	@Rooms() voterRooms []string,
	@ConnectedSocket() client *WebSocketClient,
	@CurrentUser() user *User
) {
	// Determine eligible voting rooms
	eligibleRooms := make([]string, 0)
	
	if len(vote.TargetRooms) > 0 {
		// Specific rooms requested
		for _, target := range vote.TargetRooms {
			for _, room := range voterRooms {
				if target == room {
					eligibleRooms = append(eligibleRooms, target)
					break
				}
			}
		}
	} else {
		// All user's rooms
		eligibleRooms = voterRooms
	}
	
	if len(eligibleRooms) == 0 {
		// client.Emit("vote_error", "No eligible rooms for voting")
		return
	}
	
	voteID := generateVoteID()
	
	for _, roomName := range eligibleRooms {
		// client.To(roomName).Emit("vote_initiated", voteID)
	}
	
	// Initialize vote tracking
	// initializeVote(voteID, eligibleRooms, vote)
}

