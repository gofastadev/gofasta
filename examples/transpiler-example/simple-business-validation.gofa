package main

@Injectable()
type BusinessDto struct {
    @IsNegative()
    Debt float64
    
    @IsPastDate()
    BirthDate string
    
    @IsFutureDate()
    ExpiryDate string
    
    @IsNotEmpty()
    @MinLength(3)
    Username string
    
    @IsPositive()
    UserID int
}

@Controller("/api/test")
type TestController struct {
}

@Post("/validate")
func (c *TestController) validateData(@Body() data BusinessDto) {
    // Validation will be generated automatically
}