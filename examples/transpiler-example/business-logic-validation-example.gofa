package main

@Injectable()
type FinancialService struct {
    dbConnection DatabaseConnection `inject:""`
}

func (s *FinancialService) processLoan(dto LoanApplicationDto) {
    // Body parameter validation will be generated automatically
    // Business logic decorators ensure data integrity and business rules
}

@Injectable()
type LoanApplicationDto struct {
    // Business Logic: Negative numbers for debts/liabilities
    @IsNegative()
    ExistingDebt float64         // Must be negative to represent debt amount
    
    @IsNegative()
    MonthlyExpenses float64      // Must be negative for expense tracking
    
    // Date validations for business logic
    @IsPastDate()
    BirthDate string            // Birth date must be in the past (RFC3339 format)
    
    @IsPastDate()
    @IsOptional()
    EmploymentStartDate string   // Employment start must be in past if provided
    
    @IsFutureDate()
    RequestedLoanMaturity string // Loan maturity must be in future
    
    @IsFutureDate()
    @IsOptional()
    NextReviewDate string        // Next review date must be in future if set
    
    // Database integrity validations
    @IsUnique("email")
    @IsEmail()
    Email string                 // Email must be unique in database
    
    @IsUnique("ssn")
    @Matches("^\\d{3}-\\d{2}-\\d{4}$")
    SSN string                   // SSN must be unique and properly formatted
    
    @Exists("users", "id") 
    ApplicantID int              // Must reference existing user
    
    @Exists("branches", "code")
    BranchCode string            // Must reference existing branch
    
    @IsOptional()
    @Exists("employees", "id")
    ReviewerID int               // Optional reviewer must exist if provided
    
    // Combined business logic validations
    @IsPositive()
    @Min(10000)
    @Max(1000000)
    RequestedAmount float64      // Loan amount: positive, between $10k-$1M
    
    @IsPastDate()
    @Matches("^\\d{4}-\\d{2}-\\d{2}$")
    CreditHistoryStartDate string // Credit history start: past date, YYYY-MM-DD format
}

@Injectable() 
type ProductCatalogDto struct {
    // Negative values for discounts/costs
    @IsNegative()
    DiscountPercentage float64   // Discount as negative percentage
    
    // Date validations for product lifecycle
    @IsPastDate()
    LaunchDate string            // Product launch date must be in past
    
    @IsFutureDate()
    @IsOptional()
    DiscontinueDate string       // Discontinue date must be future if set
    
    // Database relationships
    @Exists("categories", "id")
    CategoryID int               // Must reference existing category
    
    @Exists("suppliers", "code") 
    SupplierCode string          // Must reference existing supplier
    
    @IsUnique("sku")
    @Matches("^[A-Z0-9]{8,12}$")
    SKU string                   // SKU must be unique and follow format
    
    // Business constraints
    @IsPositive()
    @Min(0.01)
    Price float64                // Price must be positive, minimum 1 cent
    
    @Min(0)
    StockQuantity int            // Stock cannot be negative
}

@Injectable()
type UserAccountDto struct {
    // Account creation business rules
    @IsPastDate()
    @Matches("^\\d{4}-\\d{2}-\\d{2}$")
    DateOfBirth string           // DOB must be past, YYYY-MM-DD format
    
    @IsFutureDate()
    @IsOptional()
    SubscriptionExpiry string    // Subscription expiry must be future if set
    
    // Database integrity
    @IsUnique("username")
    @MinLength(3)
    @MaxLength(20)
    @Matches("^[a-zA-Z0-9_]+$")
    Username string              // Unique username with format constraints
    
    @IsUnique("email")
    @IsEmail()
    Email string                 // Unique email address
    
    @Exists("roles", "name")
    @IsIn("admin", "user", "moderator")
    Role string                  // Must exist in roles table and be allowed value
    
    @IsOptional()
    @Exists("users", "id")
    ReferredBy int               // Optional referrer must exist if provided
    
    // Account balance business logic
    @Min(0)
    AccountBalance float64       // Account balance cannot be negative
    
    @IsOptional()
    @IsNegative()
    CreditLimit float64          // Credit limit as negative number if applicable
}

@Controller("/api/financial")
type FinancialController struct {
    service *FinancialService `inject:""`
}

@Post("/loans/apply")
func (c *FinancialController) applyForLoan(@Body() application LoanApplicationDto) {
    c.service.processLoan(application)
}

