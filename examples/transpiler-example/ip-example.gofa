    // - secureData: Sensitive data requiring IP validation
}

@Delete("/admin/:resourceId")
func AdminActionWithAudit(
    @Ip() clientIP string,
    @Param("resourceId") resourceId string,
    @Session("adminId") adminId string,
    @Headers("X-Audit-Reason", { required: true }) auditReason string
) {
    // Admin action with IP audit logging
    // - clientIP: IP for audit trail
    // - resourceId: Resource being deleted
    // - adminId: Admin performing action
    // - auditReason: Justification for action
    // Critical for administrative audit trails
}

