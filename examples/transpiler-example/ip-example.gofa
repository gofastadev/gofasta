package main

@Controller("/api/ip")
type IpExampleController struct {
    @Inject("logger")
    Logger *Logger
}

@Get("/basic")
func BasicIpExample(
    @Ip() clientIP string
) {
    // Basic IP address access
    // - clientIP: Client's IP address from request context
    // Returns the client's IP address for logging or security checks
}

