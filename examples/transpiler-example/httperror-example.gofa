package main

import (
    "errors"
    "fmt"
    "strings"
    "time"
    "github.com/healtronlabs/gofasta/packages/core"
)

@Controller("/api/examples")
type GofastaErrorExampleController struct {
    Logger *Logger `inject:"logger"`
}

@Get("/basic-error")
func BasicErrorExample() {
    // Example: Basic GofastaError creation and throwing
    // This demonstrates simple error creation with status code and message
    
    // Create a basic 404 error
    err := core.NewNotFoundError("User", "123")
    
    // In a real controller, this would be handled by the error filter system
    // For now, this shows the basic usage pattern
    panic(err) // Will be caught by @Catch() filters when implemented
}

@Get("/formatted-error")
func FormattedErrorExample(@Query("userId") userId string) {
    // Example: BadRequestError with specific functionality
    // Shows enhanced BadRequestError with invalid fields and suggestions
    
    if userId == "" {
        err := core.NewBadRequestError("Invalid user ID - must be non-empty").
            WithInvalidFields("userId").
            WithSuggestions("Provide a valid user ID", "User ID should be alphanumeric")
        panic(err)
    }
    
    if userId == "invalid" {
        err := core.NewBadRequestError("User ID validation failed").
            WithInvalidFields("userId").
            WithSuggestions("Use numeric user ID format", "Check user ID format requirements").
            WithRequestInfo("providedValue", userId).
            WithRequestInfo("expectedFormat", "numeric")
        panic(err)
    }
}

@Post("/wrapped-error")
func WrappedErrorExample(@Body() data UserDto) {
    // Example: GofastaError wrapping another error
    // Demonstrates error chaining and cause tracking with method chaining
    
    // Simulate a database error
    dbErr := errors.New("database connection timeout after 30 seconds")
    
    // Wrap the database error in a GofastaError with method chaining
    err := core.NewInternalServerError("Failed to create user").
        WithCause(dbErr).
        WithCurrentTimestamp().
        WithPath("/api/examples/wrapped-error")
    
    panic(err)
}

@Get("/detailed-error")
func DetailedErrorExample(@Query("email") email string) {
    // Example: GofastaError with additional metadata
    // Shows validation errors with field-specific details using method chaining
    
    err := core.NewUnprocessableEntityError("Validation failed").
        WithMetadata("validationErrors", map[string][]string{
            "email": {"required", "must be valid email format"},
            "name":  {"required", "minimum 2 characters"},
            "age":   {"must be between 18 and 120"},
        }).
        WithMetadata("failedField", "email").
        WithMetadata("providedValue", email).
        WithPath("/api/examples/detailed-error").
        WithCurrentTimestamp()
    
    panic(err)
}

@Put("/chained-error")
func ChainedErrorExample(@Param("id") id string, @Body() updateData UpdateUserDto) {
    // Example: Comprehensive BadRequestError with all features
    // Demonstrates BadRequestError method chaining and complex error context
    
    // Simulate validation error
    validationErr := errors.New("age field validation failed: must be positive integer")
    
    // Create comprehensive BadRequestError with all enhanced features
    err := core.NewBadRequestError("Failed to update user profile").
        WithCause(validationErr).
        WithInvalidFields("age", "profile").
        WithSuggestions(
            "Provide age between 18 and 120",
            "Ensure age is a positive integer",
            "Check profile data completeness",
        ).
        WithRequestInfo("userId", id).
        WithRequestInfo("providedAge", updateData.Age).
        WithRequestInfo("method", "PUT").
        WithMetadata("constraints", map[string]interface{}{
            "type": "integer",
            "min":  18,
            "max":  120,
        }).
        WithPath("/api/examples/chained-error/" + id).
        WithCurrentTimestamp()
    
    panic(err)
}

@Get("/conditional-errors")
func ConditionalErrorsExample(@Query("scenario") scenario string) {
    // Example: Different GofastaError types based on conditions
    // Shows various HTTP status codes and new error creation functions
    
    switch scenario {
    case "unauthorized":
        err := core.NewUnauthorizedError("Authentication required").
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges("Bearer realm=\"API Gateway\"", "Basic").
            WithLoginUrl("https://api.example.com/auth/login")
        panic(err)
        
    case "forbidden":
        err := core.NewForbiddenError("Insufficient permissions to access this resource").
            WithRequiredPermissions("admin", "write").
            WithUserPermissions("read", "basic").
            WithResource("/api/admin/users").
            WithAction("DELETE")
        panic(err)
        
    case "not-found":
        err := core.NewNotFoundError("Resource", "unknown")
        panic(err)
        
    case "conflict":
        err := core.NewConflictError("Resource already exists")
        panic(err)
        
    case "rate-limit":
        err := core.NewTooManyRequestsError("Rate limit exceeded").
            WithMetadata("limit", 100).
            WithMetadata("window", "1h").
            WithMetadata("remaining", 0).
            WithMetadata("resetTime", "2024-01-01T01:00:00Z")
        panic(err)
        
    case "method-not-allowed":
        err := core.NewMethodNotAllowedError("POST method not allowed on this endpoint")
        panic(err)
        
    case "payload-too-large":
        err := core.NewPayloadTooLargeError("Request body exceeds 10MB limit")
        panic(err)
        
    case "service-unavailable":
        internalErr := errors.New("database cluster unavailable")
        err := core.NewServiceUnavailableError("Service temporarily unavailable").
            WithCause(internalErr)
        panic(err)
        
    default:
        err := core.NewBadRequestError("Invalid scenario parameter").
            WithInvalidFields("scenario").
            WithSuggestions(
                "Use one of the supported scenario values",
                "Check API documentation for valid scenarios",
            ).
            WithRequestInfo("providedScenario", scenario).
            WithMetadata("validScenarios", []string{
                "unauthorized", "forbidden", "not-found", "conflict", 
                "rate-limit", "method-not-allowed", "payload-too-large", "service-unavailable",
            })
        panic(err)
    }
}

@Post("/badrequest-showcase")
func BadRequestErrorShowcaseExample(@Body() userData UserRegistrationDto) {
    // Example: Comprehensive BadRequestError showcase
    // Demonstrates all BadRequestError features in a realistic validation scenario
    
    var validationErrors []string
    var invalidFields []string
    var suggestions []string
    
    // Validate email
    if userData.Email == "" {
        validationErrors = append(validationErrors, "email is required")
        invalidFields = append(invalidFields, "email")
        suggestions = append(suggestions, "Provide a valid email address")
    } else if !strings.Contains(userData.Email, "@") {
        validationErrors = append(validationErrors, "email format is invalid")
        invalidFields = append(invalidFields, "email")
        suggestions = append(suggestions, "Use format: user@domain.com")
    }
    
    // Validate age
    if userData.Age < 18 {
        validationErrors = append(validationErrors, "age must be 18 or older")
        invalidFields = append(invalidFields, "age")
        suggestions = append(suggestions, "Minimum age requirement is 18 years")
    } else if userData.Age > 120 {
        validationErrors = append(validationErrors, "age must be 120 or younger")
        invalidFields = append(invalidFields, "age")
        suggestions = append(suggestions, "Maximum age limit is 120 years")
    }
    
    // Validate password
    if len(userData.Password) < 8 {
        validationErrors = append(validationErrors, "password must be at least 8 characters")
        invalidFields = append(invalidFields, "password")
        suggestions = append(suggestions, "Use at least 8 characters for password")
    }
    
    // If there are validation errors, create comprehensive BadRequestError
    if len(validationErrors) > 0 {
        errorMessage := fmt.Sprintf("User registration validation failed: %d errors found", len(validationErrors))
        
        err := core.NewBadRequestError(errorMessage).
            WithInvalidFields(invalidFields...).
            WithSuggestions(suggestions...).
            WithRequestInfo("submittedEmail", userData.Email).
            WithRequestInfo("submittedAge", userData.Age).
            WithRequestInfo("passwordLength", len(userData.Password)).
            WithRequestInfo("validationErrorCount", len(validationErrors)).
            WithMetadata("validationDetails", map[string]interface{}{
                "errors": validationErrors,
                "requirements": map[string]interface{}{
                    "email": "Valid email format required",
                    "age":   "Must be between 18 and 120",
                    "password": "Minimum 8 characters required",
                },
                "timestamp": time.Now().Format(time.RFC3339),
            }).
            WithPath("/api/examples/badrequest-showcase").
            WithCurrentTimestamp()
        
        panic(err)
    }
}

@Post("/unauthorized-showcase")
func UnauthorizedErrorShowcaseExample(@Headers("authorization") authHeader string) {
    // Example: Comprehensive UnauthorizedError showcase
    // Demonstrates all UnauthorizedError features in realistic authentication scenarios
    
    // Check if Authorization header is present
    if authHeader == "" {
        err := core.NewUnauthorizedError("Missing authentication credentials").
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges(
                "Bearer realm=\"API Gateway\"",
                "Basic realm=\"API Gateway\"",
            ).
            WithLoginUrl("https://auth.example.com/oauth/authorize?response_type=code&client_id=demo").
            WithAuthContext("requiredAuth", true).
            WithAuthContext("authMethods", []string{"Bearer Token", "Basic Auth"}).
            WithPath("/api/examples/unauthorized-showcase").
            WithCurrentTimestamp()
        
        panic(err)
    }
    
    // Parse Bearer token
    if !strings.HasPrefix(authHeader, "Bearer ") {
        err := core.NewUnauthorizedError("Invalid authentication scheme").
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges("Bearer realm=\"API Gateway\"").
            WithAuthContext("providedScheme", strings.Split(authHeader, " ")[0]).
            WithAuthContext("expectedScheme", "Bearer").
            WithMetadata("authHeader", authHeader).
            WithLoginUrl("https://auth.example.com/oauth/authorize?response_type=code&client_id=demo")
        
        panic(err)
    }
    
    // Extract token
    token := strings.TrimPrefix(authHeader, "Bearer ")
    
    // Simulate token validation scenarios
    switch token {
    case "expired_token":
        tokenErr := errors.New("JWT token expired at 2024-01-01T00:00:00Z")
        err := core.NewUnauthorizedErrorWithCause("Token has expired", tokenErr).
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges("Bearer error=\"invalid_token\", error_description=\"The access token has expired\"").
            WithLoginUrl("https://auth.example.com/oauth/token?grant_type=refresh_token").
            WithAuthContext("tokenType", "JWT").
            WithAuthContext("expiredAt", "2024-01-01T00:00:00Z").
            WithAuthContext("currentTime", time.Now().Format(time.RFC3339)).
            WithAuthContext("canRefresh", true).
            WithMetadata("tokenHash", "sha256:abc123...").
            WithMetadata("userId", "user_12345")
        
        panic(err)
        
    case "invalid_signature":
        sigErr := errors.New("JWT signature verification failed: invalid key ID")
        err := core.NewUnauthorizedErrorf("Token validation failed: %s", "signature mismatch").
            WithCause(sigErr).
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges("Bearer error=\"invalid_token\", error_description=\"Token signature is invalid\"").
            WithAuthContext("tokenType", "JWT").
            WithAuthContext("algorithm", "RS256").
            WithAuthContext("keyId", "unknown_key").
            WithAuthContext("validKeyIds", []string{"key1", "key2", "key3"}).
            WithMetadata("securityLevel", "high").
            WithMetadata("validationTime", time.Now().Format(time.RFC3339))
        
        panic(err)
        
    case "insufficient_scope":
        err := core.NewUnauthorizedError("Insufficient token scope for requested operation").
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges("Bearer error=\"insufficient_scope\", scope=\"admin write\"").
            WithAuthContext("tokenType", "OAuth2").
            WithAuthContext("currentScope", "read").
            WithAuthContext("requiredScope", "admin write").
            WithAuthContext("clientId", "client_123").
            WithMetadata("operation", "POST /api/examples/unauthorized-showcase").
            WithMetadata("resource", "user_data").
            WithMetadata("permission", "write")
        
        panic(err)
        
    case "revoked_token":
        err := core.NewUnauthorizedError("Token has been revoked").
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges("Bearer error=\"invalid_token\", error_description=\"Token was revoked\"").
            WithAuthContext("tokenType", "JWT").
            WithAuthContext("revokedAt", "2024-01-15T10:30:00Z").
            WithAuthContext("revokedBy", "admin").
            WithAuthContext("revokedReason", "security_breach").
            WithLoginUrl("https://auth.example.com/auth/reauthorize").
            WithMetadata("tokenId", "token_78901").
            WithMetadata("sessionId", "session_abc123")
        
        panic(err)
        
    case "malformed_token":
        parseErr := errors.New("invalid JWT format: missing signature segment")
        err := core.NewUnauthorizedErrorWithCause("Token format is invalid", parseErr).
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges("Bearer error=\"invalid_request\", error_description=\"Malformed token\"").
            WithAuthContext("tokenType", "JWT").
            WithAuthContext("expectedFormat", "header.payload.signature").
            WithAuthContext("providedSegments", strings.Count(token, ".") + 1).
            WithAuthContext("expectedSegments", 3).
            WithMetadata("tokenLength", len(token)).
            WithMetadata("parsingAttempt", time.Now().Format(time.RFC3339))
        
        panic(err)
        
    default:
        // Valid token scenario - this would normally succeed
        // For demo purposes, we'll show a rate-limited authentication scenario
        err := core.NewUnauthorizedError("Too many authentication attempts").
            WithAuthScheme("Bearer").
            WithRealm("API Gateway").
            WithChallenges("Bearer error=\"temporarily_unavailable\", error_description=\"Rate limit exceeded\"").
            WithAuthContext("tokenType", "valid").
            WithAuthContext("rateLimitHit", true).
            WithAuthContext("retryAfter", "300s").
            WithAuthContext("attemptsRemaining", 0).
            WithMetadata("rateLimitWindow", "1h").
            WithMetadata("maxAttempts", 100).
            WithMetadata("currentAttempts", 100).
            WithLoginUrl("https://auth.example.com/auth/wait")
        
        panic(err)
    }
}

@Get("/oauth-error")
func OAuthErrorExample(@Query("grant_type") grantType string, @Query("client_id") clientId string) {
    // Example: OAuth2 specific authentication errors
    // Shows OAuth2 protocol-specific error handling with UnauthorizedError
    
    if clientId == "" {
        err := core.NewUnauthorizedError("Missing client_id parameter").
            WithAuthScheme("OAuth2").
            WithRealm("OAuth2 Authorization Server").
            WithChallenges("OAuth2 error=\"invalid_request\", error_description=\"client_id parameter is required\"").
            WithAuthContext("grantType", grantType).
            WithAuthContext("requiredParams", []string{"client_id", "grant_type"}).
            WithLoginUrl("https://auth.example.com/oauth/authorize?response_type=code&client_id=YOUR_CLIENT_ID")
        
        panic(err)
    }
    
    if grantType == "authorization_code" {
        // Simulate invalid client credentials
        clientErr := errors.New("client authentication failed: invalid client_secret")
        err := core.NewUnauthorizedErrorWithCause("Client authentication required", clientErr).
            WithAuthScheme("OAuth2").
            WithRealm("OAuth2 Authorization Server").
            WithChallenges(
                "OAuth2 error=\"invalid_client\"",
                "Basic realm=\"OAuth2 Client Authentication\"",
            ).
            WithAuthContext("grantType", grantType).
            WithAuthContext("clientId", clientId).
            WithAuthContext("authMethod", "client_secret_basic").
            WithMetadata("oauth2Flow", "authorization_code").
            WithMetadata("step", "token_exchange")
        
        panic(err)
    }
    
    if grantType == "refresh_token" {
        // Simulate refresh token issues
        err := core.NewUnauthorizedError("Refresh token is invalid or expired").
            WithAuthScheme("OAuth2").
            WithRealm("OAuth2 Authorization Server").
            WithChallenges("OAuth2 error=\"invalid_grant\", error_description=\"Refresh token expired\"").
            WithAuthContext("grantType", grantType).
            WithAuthContext("clientId", clientId).
            WithAuthContext("refreshTokenExpired", true).
            WithAuthContext("originalTokenExpiry", "2024-01-01T00:00:00Z").
            WithLoginUrl("https://auth.example.com/oauth/authorize?response_type=code&client_id=" + clientId).
            WithMetadata("oauth2Flow", "refresh_token").
            WithMetadata("requiresReauthorization", true)
        
        panic(err)
    }
    
    // Default: unsupported grant type
    err := core.NewUnauthorizedError("Unsupported grant type").
        WithAuthScheme("OAuth2").
        WithRealm("OAuth2 Authorization Server").
        WithChallenges("OAuth2 error=\"unsupported_grant_type\"").
        WithAuthContext("providedGrantType", grantType).
        WithAuthContext("supportedGrantTypes", []string{"authorization_code", "refresh_token", "client_credentials"}).
        WithMetadata("oauth2Spec", "RFC 6749").
        WithMetadata("errorType", "protocol_error")
    
    panic(err)
}

@Post("/forbidden-showcase")
func ForbiddenErrorShowcaseExample(@Headers("x-user-id") userId string, @Headers("x-user-role") userRole string) {
    // Example: Comprehensive ForbiddenError showcase
    // Demonstrates all ForbiddenError features in realistic authorization scenarios
    
    if userId == "" {
        err := core.NewForbiddenError("User identification required for authorization").
            WithResource("/api/examples/forbidden-showcase").
            WithAction("POST").
            WithAccessContext("authenticationStatus", "missing").
            WithAccessContext("requiredHeaders", []string{"x-user-id", "x-user-role"})
        
        panic(err)
    }
    
    // Simulate role-based access control scenarios
    switch userRole {
    case "guest":
        err := core.NewForbiddenError("Guest users cannot access administrative functions").
            WithRequiredPermissions("user", "authenticated").
            WithUserPermissions("guest", "anonymous").
            WithResource("/api/examples/forbidden-showcase").
            WithAction("POST").
            WithAccessContext("userId", userId).
            WithAccessContext("userRole", userRole).
            WithAccessContext("accessLevel", "restricted").
            WithAccessContext("upgradeRequired", true)
        
        panic(err)
        
    case "user":
        err := core.NewForbiddenError("Standard users lack administrative privileges").
            WithRequiredPermissions("admin", "system:write", "config:modify").
            WithUserPermissions("user", "basic:read", "profile:write").
            WithResource("/api/examples/forbidden-showcase").
            WithAction("POST").
            WithAccessContext("userId", userId).
            WithAccessContext("userRole", userRole).
            WithAccessContext("requiredRole", "admin").
            WithAccessContext("accessEscalationAvailable", false).
            WithMetadata("rbacEngine", "custom").
            WithMetadata("policyVersion", "v1.0")
        
        panic(err)
        
    case "moderator":
        // Moderators can read but not modify this specific resource
        rbacErr := errors.New("policy evaluation failed: insufficient role hierarchy level")
        err := core.NewForbiddenErrorWithCause("Moderator role insufficient for system configuration", rbacErr).
            WithRequiredPermissions("admin", "system:config", "global:modify").
            WithUserPermissions("moderator", "content:moderate", "user:manage").
            WithResource("/api/examples/forbidden-showcase").
            WithAction("POST").
            WithAccessContext("userId", userId).
            WithAccessContext("userRole", userRole).
            WithAccessContext("requiredMinimumRole", "admin").
            WithAccessContext("hierarchyLevel", 2).
            WithAccessContext("requiredHierarchyLevel", 3).
            WithMetadata("rbacEngine", "hierarchical").
            WithMetadata("policyEvaluationTime", "23ms")
        
        panic(err)
        
    case "admin":
        // Simulate IP-based restrictions for admin actions
        if userId == "admin_remote" {
            err := core.NewForbiddenError("Administrative actions restricted from remote locations").
                WithRequiredPermissions("admin", "system:write").
                WithUserPermissions("admin", "system:write", "global:manage").
                WithResource("/api/examples/forbidden-showcase").
                WithAction("POST").
                WithAccessContext("userId", userId).
                WithAccessContext("userRole", userRole).
                WithAccessContext("accessLocation", "remote").
                WithAccessContext("requiredLocation", "office_network").
                WithAccessContext("clientIp", "203.0.113.45").
                WithAccessContext("allowedIpRanges", []string{"10.0.0.0/8", "192.168.0.0/16"}).
                WithMetadata("securityPolicy", "location_based_access").
                WithMetadata("complianceLevel", "high")
            
            panic(err)
        }
        
        // Simulate time-based restrictions
        if userId == "admin_weekend" {
            err := core.NewForbiddenError("Administrative operations restricted during weekends").
                WithRequiredPermissions("admin", "system:write").
                WithUserPermissions("admin", "system:write", "global:manage").
                WithResource("/api/examples/forbidden-showcase").
                WithAction("POST").
                WithAccessContext("userId", userId).
                WithAccessContext("userRole", userRole).
                WithAccessContext("currentTime", time.Now().Format(time.RFC3339)).
                WithAccessContext("accessWindow", "Monday-Friday 09:00-17:00").
                WithAccessContext("timeRestrictionActive", true).
                WithMetadata("temporalPolicy", "business_hours_only").
                WithMetadata("timezone", "UTC")
            
            panic(err)
        }
        
    default:
        err := core.NewForbiddenError("Unrecognized user role").
            WithUserPermissions("unknown").
            WithResource("/api/examples/forbidden-showcase").
            WithAction("POST").
            WithAccessContext("userId", userId).
            WithAccessContext("providedRole", userRole).
            WithAccessContext("validRoles", []string{"guest", "user", "moderator", "admin"}).
            WithMetadata("roleValidation", "failed").
            WithMetadata("securityEvent", true)
        
        panic(err)
    }
}

@Get("/rbac-error")
func RBACErrorExample(@Query("resource") resource string, @Query("action") action string, @Headers("x-user-permissions") userPerms string) {
    // Example: Role-Based Access Control (RBAC) specific errors
    // Shows detailed permission and resource-based access control
    
    if resource == "" || action == "" {
        err := core.NewForbiddenError("Resource and action parameters required for RBAC evaluation").
            WithAccessContext("missingParams", []string{
                func() string { if resource == "" { return "resource" }; return "" }(),
                func() string { if action == "" { return "action" }; return "" }(),
            }).
            WithAccessContext("rbacEvaluationFailed", true)
        
        panic(err)
    }
    
    // Parse user permissions (simulate comma-separated list)
    permissions := []string{}
    if userPerms != "" {
        permissions = strings.Split(userPerms, ",")
    }
    
    // Define required permissions for different resources
    resourcePermissions := map[string]map[string][]string{
        "users": {
            "read":   {"user:read"},
            "write":  {"user:write"},
            "delete": {"user:delete", "admin"},
        },
        "system": {
            "read":   {"system:read", "admin"},
            "write":  {"system:write", "admin"},
            "delete": {"system:delete", "super_admin"},
        },
        "billing": {
            "read":   {"billing:read", "finance"},
            "write":  {"billing:write", "finance", "admin"},
            "delete": {"billing:delete", "finance_admin"},
        },
    }
    
    requiredPerms, resourceExists := resourcePermissions[resource]
    if !resourceExists {
        err := core.NewForbiddenError("Access to unknown resource type").
            WithResource(resource).
            WithAction(action).
            WithUserPermissions(permissions...).
            WithAccessContext("unknownResource", resource).
            WithAccessContext("availableResources", []string{"users", "system", "billing"}).
            WithMetadata("rbacEngine", "resource_based").
            WithMetadata("resourceDiscovery", "failed")
        
        panic(err)
    }
    
    actionPerms, actionExists := requiredPerms[action]
    if !actionExists {
        err := core.NewForbiddenError("Unsupported action for resource type").
            WithResource(resource).
            WithAction(action).
            WithUserPermissions(permissions...).
            WithAccessContext("unsupportedAction", action).
            WithAccessContext("availableActions", []string{"read", "write", "delete"}).
            WithMetadata("rbacEngine", "action_based").
            WithMetadata("actionValidation", "failed")
        
        panic(err)
    }
    
    // Check if user has required permissions
    hasPermission := false
    for _, required := range actionPerms {
        for _, userPerm := range permissions {
            if strings.TrimSpace(userPerm) == required {
                hasPermission = true
                break
            }
        }
        if hasPermission {
            break
        }
    }
    
    if !hasPermission {
        rbacErr := errors.New("permission matrix evaluation failed: no matching grants found")
        err := core.NewForbiddenErrorWithCause("RBAC permission check failed", rbacErr).
            WithRequiredPermissions(actionPerms...).
            WithUserPermissions(permissions...).
            WithResource(resource).
            WithAction(action).
            WithAccessContext("permissionGap", true).
            WithAccessContext("evaluationMethod", "matrix_lookup").
            WithAccessContext("grantType", "explicit").
            WithMetadata("rbacEngine", "permission_matrix").
            WithMetadata("evaluationLatency", "12ms").
            WithMetadata("cacheHit", false)
        
        panic(err)
    }
    
    // If we get here, permission check passed (for demo, we'll simulate a different failure)
    err := core.NewForbiddenError("Resource temporarily locked for maintenance").
        WithRequiredPermissions(actionPerms...).
        WithUserPermissions(permissions...).
        WithResource(resource).
        WithAction(action).
        WithAccessContext("resourceStatus", "maintenance_locked").
        WithAccessContext("lockReason", "scheduled_upgrade").
        WithAccessContext("estimatedUnlockTime", "2024-01-20T02:00:00Z").
        WithMetadata("maintenanceWindow", true).
        WithMetadata("lockType", "administrative")
    
    panic(err)
}

@Post("/business-logic-error")
func BusinessLogicErrorExample(@Body() orderData OrderDto) {
    // Example: Business logic errors with context
    // Shows how to handle complex business rule violations
    
    if orderData.Quantity <= 0 {
        err := NewHttpError(422, "Invalid order quantity").
            WithDetails(map[string]interface{}{
                "field":         "quantity",
                "value":         orderData.Quantity,
                "constraint":    "must be greater than 0",
                "businessRule":  "positive_quantity_required",
            })
        panic(err)
    }
    
    if orderData.Total < orderData.Quantity * orderData.ItemPrice {
        calculatedTotal := orderData.Quantity * orderData.ItemPrice
        err := NewHttpError(422, "Order total does not match calculated amount").
            WithDetails(map[string]interface{}{
                "providedTotal":   orderData.Total,
                "calculatedTotal": calculatedTotal,
                "quantity":        orderData.Quantity,
                "itemPrice":       orderData.ItemPrice,
                "businessRule":    "total_calculation_mismatch",
            })
        panic(err)
    }
}

@Get("/error-inspection")
func ErrorInspectionExample(@Query("testError") testError string) {
    // Example: Error inspection and type checking
    // Shows how to work with errors using the helper functions
    
    var err error
    
    // Create different types of errors based on parameter
    switch testError {
    case "http":
        err = NewHttpError(400, "Bad request error")
    case "wrapped":
        cause := errors.New("underlying issue")
        err = NewHttpErrorWithCause(500, "Wrapped error", cause)
    case "regular":
        err = errors.New("regular Go error")
    default:
        err = NewHttpError(400, "Invalid testError parameter")
    }
    
    // Demonstrate error inspection
    if IsHttpError(err) {
        httpErr := GetHttpError(err)
        if httpErr != nil {
            // Log error details (in real implementation)
            // fmt.Printf("HTTP Error: Status=%d, Message=%s\n", httpErr.StatusCode, httpErr.Message)
            
            // Check for specific status codes
            if IsHttpError(err, 400, 422) {
                // Handle client errors
            } else if IsHttpError(err, 500, 502, 503) {
                // Handle server errors
            }
            
            // Check for wrapped errors
            if cause := Unwrap(err); cause != nil {
                // Handle underlying cause
                // fmt.Printf("Caused by: %v\n", cause)
            }
        }
    }
    
    panic(err)
}

@Get("/multiple-errors")
func MultipleErrorsExample(@Query("fields") fields string) {
    // Example: Multiple validation errors aggregation
    // Shows how to collect and present multiple errors
    
    var validationErrors []error
    
    if !strings.Contains(fields, "name") {
        validationErrors = append(validationErrors, NewHttpError(422, "Name field is required"))
    }
    
    if !strings.Contains(fields, "email") {
        validationErrors = append(validationErrors, NewHttpError(422, "Email field is required"))
    }
    
    if !strings.Contains(fields, "age") {
        validationErrors = append(validationErrors, NewHttpError(422, "Age field is required"))
    }
    
    if len(validationErrors) > 0 {
        // Join all error messages
        combinedMessage := JoinMessages(validationErrors, "; ")
        
        err := NewHttpError(422, "Multiple validation errors").
            WithDetails(map[string]interface{}{
                "message":    combinedMessage,
                "errorCount": len(validationErrors),
                "errors":     validationErrors,
            })
        
        panic(err)
    }
}

@Delete("/resource/:id")
func ResourceDeletionExample(@Param("id") id string, @Session("userId") userId string) {
    // Example: Resource operation errors with context
    // Shows authentication, authorization, and resource state errors
    
    if userId == "" {
        err := NewHttpError(401, "Authentication required for resource deletion").
            WithPath("/api/examples/resource/" + id)
        panic(err)
    }
    
    // Simulate checking resource ownership
    if userId != "owner-id" {
        err := NewHttpError(403, "Insufficient permissions to delete this resource").
            WithDetails(map[string]interface{}{
                "resourceId":    id,
                "userId":        userId,
                "requiredRole":  "owner",
                "operation":     "delete",
            }).
            WithPath("/api/examples/resource/" + id)
        panic(err)
    }
    
    // Simulate resource not found
    if id == "nonexistent" {
        err := NewHttpError(404, "Resource not found").
            WithDetails(map[string]interface{}{
                "resourceId":   id,
                "resourceType": "user",
            }).
            WithPath("/api/examples/resource/" + id)
        panic(err)
    }
    
    // Simulate resource in use (cannot delete)
    if id == "in-use" {
        err := NewHttpError(409, "Cannot delete resource: currently in use").
            WithDetails(map[string]interface{}{
                "resourceId":     id,
                "conflictReason": "resource_in_use",
                "dependencies":   []string{"active_sessions", "pending_orders"},
            })
        panic(err)
    }
}

@Get("/status-code-examples")
func StatusCodeExamplesExample(@Query("code") statusCode string) {
    // Example: Various HTTP status codes with appropriate contexts
    // Demonstrates proper usage of different status codes
    
    switch statusCode {
    case "400":
        err := NewHttpError(400, "Bad Request - Invalid input parameters")
        panic(err)
        
    case "401":
        err := NewHttpError(401, "Unauthorized - Valid authentication credentials required")
        panic(err)
        
    case "403":
        err := NewHttpError(403, "Forbidden - Access denied to requested resource")
        panic(err)
        
    case "404":
        err := NewHttpError(404, "Not Found - Requested resource does not exist")
        panic(err)
        
    case "405":
        err := NewHttpError(405, "Method Not Allowed - HTTP method not supported for this endpoint")
        panic(err)
        
    case "408":
        err := NewHttpError(408, "Request Timeout - Request processing exceeded time limit")
        panic(err)
        
    case "409":
        err := NewHttpError(409, "Conflict - Request conflicts with current resource state")
        panic(err)
        
    case "410":
        err := NewHttpError(410, "Gone - Requested resource is no longer available")
        panic(err)
        
    case "413":
        err := NewHttpError(413, "Payload Too Large - Request body exceeds size limits")
        panic(err)
        
    case "415":
        err := NewHttpError(415, "Unsupported Media Type - Content type not supported")
        panic(err)
        
    case "422":
        err := NewHttpError(422, "Unprocessable Entity - Request is well-formed but contains semantic errors")
        panic(err)
        
    case "429":
        err := NewHttpError(429, "Too Many Requests - Rate limit exceeded")
        panic(err)
        
    case "500":
        err := NewHttpError(500, "Internal Server Error - Unexpected server error occurred")
        panic(err)
        
    case "501":
        err := NewHttpError(501, "Not Implemented - Requested functionality not implemented")
        panic(err)
        
    case "502":
        err := NewHttpError(502, "Bad Gateway - Invalid response from upstream server")
        panic(err)
        
    case "503":
        err := NewHttpError(503, "Service Unavailable - Server temporarily unable to handle requests")
        panic(err)
        
    case "504":
        err := NewHttpError(504, "Gateway Timeout - Upstream server response timeout")
        panic(err)
        
    default:
        err := NewHttpError(400, "Invalid status code parameter").
            WithDetails(map[string]interface{}{
                "providedCode": statusCode,
                "supportedCodes": []string{
                    "400", "401", "403", "404", "405", "408", "409", "410",
                    "413", "415", "422", "429", "500", "501", "502", "503", "504",
                },
            })
        panic(err)
    }
}