type ChatMessage struct {
	content string
	userID  string
	roomID  string
}

type TypingData struct {
	userID string
	isTyping bool
}

@Injectable()
type ChatService struct {}

type ChatResponse struct {
	ID string
	Content string
	UserID string
	Timestamp string
}