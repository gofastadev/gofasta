// === DATA STRUCTURES ===

type TenantOperation struct {
	Type string      `json:"type"`
	Data interface{} `json:"data"`
}

type CrossNamespaceSync struct {
	Type          string   `json:"type"`
	TargetTenants []string `json:"target_tenants"`
	Data          interface{} `json:"data"`
}

type HierarchyOperation struct {
	Type          string `json:"type"`
	PropagateUp   bool   `json:"propagate_up"`
	PropagateDown bool   `json:"propagate_down"`
}

type PolicyEnforcement struct {
	PolicyType string      `json:"policy_type"`
	Rules      interface{} `json:"rules"`
}

type NamespacePolicy struct {
	Type  string `json:"type"`
	Rules []string `json:"rules"`
}

type NamespaceMonitoring struct {
	Metrics  []string `json:"metrics"`
	Interval int      `json:"interval"`
}

type PerformanceAnalysis struct {
	TimeRange    string `json:"time_range"`
	AnalysisType string `json:"analysis_type"`
}

type NamespaceScaling struct {
	MinInstances int `json:"min_instances"`
	MaxInstances int `json:"max_instances"`
	TargetCPU    int `json:"target_cpu"`
}

type NamespaceLoad struct {
	CPU    float64 `json:"cpu"`
	Memory float64 `json:"memory"`
}

type ScalingAction struct {
	Action string `json:"action"`
	Reason string `json:"reason"`
}

type LoadDistribution struct {
	Balanced bool `json:"balanced"`
}

type BalancingPlan struct {
	RebalanceNeeded bool `json:"rebalance_needed"`
}

type SecurityAuditResults struct {
	RiskLevel string   `json:"risk_level"`
	Issues    []string `json:"issues"`
}

type ComplianceMonitoring struct {
	Standards []string `json:"standards"`
}

// === SERVICES ===

@Injectable()
type NamespaceManager struct{}

@Injectable()
type TenantService struct{}

// === TYPES ===

type User struct {
	ID   string `json:"id"`
	Name string `json:"name"`
	Role string `json:"role"`
}

type WebSocketClient struct {
	id string
}

type AckCallback struct{}