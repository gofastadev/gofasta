package main

// WebSocket Message Handler Example
// Demonstrates Section 2.5: WebSocket message handler code generation
// Shows comprehensive WebSocket decorator support and message handling

// Basic Chat Gateway with message handlers
@WebSocketGateway(8080)
type ChatGateway struct {
	@Inject("chatService")
	chatService *ChatService
	
	@Inject("logger") 
	logger *Logger
	
	@Inject("userService")
	userService *UserService
}

// Advanced Game Gateway with full configuration
@WebSocketGateway({
	port: 9000,
	namespace: "/game",
	cors: true
})
type GameGateway struct {
	@Inject("gameService")
	gameService *GameService
	
	@Inject("roomManager")
	roomManager *RoomManager
}

// Real-time Notification Gateway
@WebSocketGateway({
	port: 9001,
	namespace: "/notifications",
	cors: true
})
type NotificationGateway struct {
	@Inject("notificationService")
	notificationService *NotificationService
}

// === MESSAGE HANDLERS ===

// Basic message handling with acknowledgment
@SubscribeMessage("chat_message")
func HandleChatMessage(
	@MessageBody() message *ChatMessage,
	@ConnectedSocket() client *WebSocketClient,
	@MessageAck() ack *AckCallback
) error {
	// Validate message
	if message.Content == "" {
		return fmt.Errorf("message content cannot be empty")
	}
	
	// Process and broadcast message
	// ack.Send(map[string]interface{}{"status": "received"})
	return nil
}

