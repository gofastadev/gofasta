package main

// Basic example demonstrating @MessageAck() parameter decorator
// Shows how to handle WebSocket message acknowledgments for reliable messaging

@WebSocketGateway(3000)
type MessageAckGateway struct {
	@Inject("messageService")
	messageService *MessageService
}

// === BASIC ACKNOWLEDGMENT PATTERNS ===

// Simple acknowledgment - confirm message received
@SubscribeMessage("ping")
func HandlePing(
	@MessageBody() message string,
	@MessageAck() ack *AckCallback
) {
	// Process the ping message
	// Immediately acknowledge receipt
	// ack.Success("pong")
}

// Acknowledgment with data - return processed result
@SubscribeMessage("calculate")
func HandleCalculation(
	@MessageBody() data *CalculationRequest,
	@MessageAck() ack *AckCallback
) {
	// Perform calculation
	result := data.A + data.B
	
	// Acknowledge with result
	// ack.Success(map[string]interface{}{
	//     "result": result,
	//     "operation": "addition",
	// })
}

// Error handling with acknowledgment
@SubscribeMessage("validate_data")
func HandleDataValidation(
	@MessageBody() data *UserData,
	@MessageAck() ack *AckCallback
) {
	// Validate the data
	if data.Email == "" {
		// Send error acknowledgment
		// ack.Error("Email is required")
		return
	}
	
	if len(data.Password) < 8 {
		// Send error with details
		// ack.Error("Password must be at least 8 characters")
		return
	}
	
	// Validation successful
	// ack.Success("Data validation passed")
}

// === ACKNOWLEDGMENT WITH MULTIPLE DECORATORS ===

// Combine with other WebSocket decorators
@SubscribeMessage("join_room")
func HandleJoinRoom(
	@MessageBody() roomData *JoinRoomRequest,
	@ConnectedSocket() client *WebSocketClient,
	@MessageAck() ack *AckCallback
) {
	// Validate room access
	if !isValidRoom(roomData.RoomID) {
		// ack.Error("Invalid room ID")
		return
	}
	
	// Join the room
	// client.Join(roomData.RoomID)
	
	// Acknowledge successful join
	// ack.Success(map[string]interface{}{
	//     "roomID": roomData.RoomID,
	//     "message": "Successfully joined room",
	// })
}

