// Leave room with validation
@SubscribeMessage("leave_room")
func HandleLeaveRoom(
	@MessageBody() request *LeaveRoomRequest,
	@Rooms() currentRooms []string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Check if actually in the room
	inRoom := false
	for _, room := range currentRooms {
		if room == request.RoomName {
			inRoom = true
			break
		}
	}

	if !inRoom {
