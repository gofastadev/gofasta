// === ROOM STATISTICS PATTERNS ===

// Get room statistics
@SubscribeMessage("get_room_stats")
func HandleGetRoomStats(
	@Rooms() rooms []string,
	@ConnectedSocket() client *WebSocketClient
) {
	stats := make(map[string]interface{})
	stats["totalRooms"] = len(rooms)
	stats["rooms"] = rooms

