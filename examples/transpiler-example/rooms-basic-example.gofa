package main

// Basic example demonstrating @Rooms() parameter decorator
// Shows how to access and work with WebSocket room collections for group messaging

@WebSocketGateway(3000)
type RoomsGateway struct {
	@Inject("roomService")
	roomService *RoomService
}

// === BASIC ROOM ACCESS PATTERNS ===

// Access current client's rooms
@SubscribeMessage("get_my_rooms")
func HandleGetMyRooms(
	@Rooms() rooms []string,
	@ConnectedSocket() client *WebSocketClient
) {
