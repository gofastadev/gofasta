	// client.Emit("my_rooms", map[string]interface{}{
	//     "rooms": rooms,
	//     "count": len(rooms),
	// })
}

// Room-based broadcasting with current room list
@SubscribeMessage("broadcast_to_my_rooms") 
func HandleBroadcastToMyRooms(
	@MessageBody() message *BroadcastMessage,
	@Rooms() rooms []string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Broadcast message to all rooms the client is currently in
	for _, roomName := range rooms {
		// client.To(roomName).Emit("room_message", map[string]interface{}{
		//     "message": message.Content,
		//     "sender": client.ID(),
		//     "room": roomName,
		//     "timestamp": time.Now(),
		// })
	}
}

// === ROOM VALIDATION PATTERNS ===

// Check if client is in specific rooms
@SubscribeMessage("check_room_access")
func HandleCheckRoomAccess(
	@MessageBody() request *RoomAccessRequest,
	@Rooms() rooms []string
) {
	// Check if client has access to requested room
	hasAccess := false
	for _, room := range rooms {
		if room == request.RoomName {
			hasAccess = true
			break
		}
	}

	// response := map[string]interface{}{
	//     "roomName": request.RoomName,
	//     "hasAccess": hasAccess,
	//     "currentRooms": rooms,
	// }
	// client.Emit("room_access_result", response)
}

// Room-based message filtering
@SubscribeMessage("send_room_message")
func HandleSendRoomMessage(
	@MessageBody() message *RoomMessage,
	@Rooms() rooms []string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Only allow sending to rooms the client is actually in
	canSend := false
	for _, room := range rooms {
		if room == message.TargetRoom {
			canSend = true
			break
		}
	}

	if !canSend {
		// client.Emit("error", "You are not in room: " + message.TargetRoom)
		return
	}

	// Send message to the target room
	// client.To(message.TargetRoom).Emit("room_message", map[string]interface{}{
	//     "content": message.Content,
	//     "sender": client.ID(),
	//     "room": message.TargetRoom,
	// })
}

