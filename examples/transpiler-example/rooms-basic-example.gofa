// Room presence notification
@SubscribeMessage("notify_room_presence")
func HandleNotifyRoomPresence(
	@Rooms() rooms []string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Notify all rooms about client's presence
	presenceMessage := map[string]interface{}{
		"clientID": client.ID(),
		"action":   "presence_check",
		"rooms":    rooms,
	}

	for _, roomName := range rooms {
		// client.To(roomName).Emit("member_presence", presenceMessage)
	}
}

// === HELPER FUNCTIONS ===

func isValidRoom(roomName string) bool {
	// Simple validation - room names must be non-empty and not contain special characters
	return roomName != "" && len(roomName) <= 50
}

func getRemainingRooms(currentRooms []string, leaveRoom string) []string {
	remaining := make([]string, 0)
	for _, room := range currentRooms {
		if room != leaveRoom {
			remaining = append(remaining, room)
		}
	}
	return remaining
}

// === DATA STRUCTURES ===

type BroadcastMessage struct {
	Content string `json:"content"`
	Type    string `json:"type"`
}

type RoomAccessRequest struct {
	RoomName string `json:"room_name"`
}

type RoomMessage struct {
	Content    string `json:"content"`
	TargetRoom string `json:"target_room"`
}

type JoinRoomRequest struct {
	RoomName string `json:"room_name"`
	Password string `json:"password,omitempty"`
}

type LeaveRoomRequest struct {
	RoomName string `json:"room_name"`
}

// === SERVICES ===

@Injectable()
type RoomService struct{}

// === TYPES ===

type WebSocketClient struct {
	id string
}