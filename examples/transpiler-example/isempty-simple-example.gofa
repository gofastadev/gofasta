package main

@Injectable()
type FormService struct {
}

func (s *FormService) submitForm(dto FormDto) {
    // Body parameter validation will be generated automatically
    // The dto will be validated using the @IsEmpty() decorators
}

@Injectable()
type FormDto struct {
    @IsEmpty()
    OptionalComments string   // Must be empty (not filled out)

    @IsEmpty()
    UnusedField string        // Must be empty (deprecated field)
    
    @IsEmpty()
    TempData []string         // Must be empty (temporary array should not have data)
    
    @IsEmpty()
    LegacyNotes string        // Must be empty (legacy field no longer used)
}

@Controller("/api/forms")
type FormController struct {
    service *FormService `inject:""`
}

@Post("/submit")
func (c *FormController) submitForm(@Body() form FormDto) {
    c.service.submitForm(form)
}