package main

// @Redirect() decorator example demonstrating various redirect scenarios

@Controller("/old-api")
type LegacyController struct {}

// Basic temporary redirect (302) with default status code
@Redirect("https://newdomain.com/api/v2/users")
@Get("/users")
func RedirectUsers() {}

// Permanent redirect (301) for moved resources
@Redirect("https://newdomain.com/api/v2/products", 301)
@Get("/products")
func RedirectProducts() {}

// Temporary redirect (307) preserving HTTP method
@Redirect("/api/v2/orders", 307)
@Post("/orders")
func RedirectCreateOrder() {}

// Permanent redirect (308) preserving HTTP method
@Redirect("/api/v2/payments", 308)
@Put("/payments/:id")
func RedirectUpdatePayment() {}

@Controller("/migration")
type MigrationController struct {}

// Domain migration redirects
@Redirect("https://app.newcompany.com/", 301)
@Get("/")
func RedirectHomepage() {}

@Redirect("https://app.newcompany.com/dashboard", 301)
@Get("/dashboard")
func RedirectDashboard() {}

@Redirect("https://app.newcompany.com/settings", 301)
@Get("/settings")
func RedirectSettings() {}

@Controller("/maintenance")
type MaintenanceController struct {}

// Temporary redirects for maintenance mode
@Redirect("/maintenance-page", 302)
@Get("/admin")
func RedirectAdmin() {}

@Redirect("/maintenance-page", 302)
@Get("/reports")
func RedirectReports() {}

@Controller("/seo")
type SEOController struct {}

// SEO-friendly redirects for URL changes
@Redirect("/blog", 301)
@Get("/news")
func RedirectNewsToBlog() {}

@Redirect("/products", 301)
@Get("/items")
func RedirectItemsToProducts() {}

@Redirect("/support", 301)
@Get("/help")
func RedirectHelpToSupport() {}

@Redirect("/about", 301)
@Get("/company")
func RedirectCompanyToAbout() {}

@Controller("/api/v1")
type APIVersionController struct {}

// API versioning redirects
@Redirect("/api/v2/users", 301)
@Get("/users")
func RedirectV1Users() {}

@Redirect("/api/v2/auth/login", 301)
@Post("/auth/login")
func RedirectV1Login() {}

@Redirect("/api/v2/auth/logout", 301)
@Post("/auth/logout")
func RedirectV1Logout() {}