// Namespace-based message filtering
@SubscribeMessage("send_namespace_message")
func HandleSendNamespaceMessage(
	@MessageBody() message *NamespaceMessage,
	@Namespace() namespace string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Ensure message is being sent within correct namespace
	if namespace != message.Namespace {
		// client.Emit("error", fmt.Sprintf("Namespace mismatch: connected to '%s', trying to send to '%s'", namespace, message.Namespace))
		return
	}

	// Send message within the namespace
	// client.Broadcast().Emit("namespace_message", map[string]interface{}{
	//     "content": message.Content,
	//     "sender": client.ID(),
	//     "namespace": namespace,
	// })
}

// === NAMESPACE ROUTING PATTERNS ===

// Route messages based on namespace
@SubscribeMessage("route_by_namespace")
func HandleRouteByNamespace(
	@MessageBody() message *RoutableMessage,
	@Namespace() namespace string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Route to different handlers based on namespace
	switch namespace {
	case "/admin":
		handleAdminMessage(message, client)
	case "/user":
		handleUserMessage(message, client)
	case "/api":
		handleAPIMessage(message, client)
	default:
		handleDefaultMessage(message, client, namespace)
	}
}

