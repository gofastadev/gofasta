package main

// Basic example demonstrating @Namespace() parameter decorator
// Shows how to access and work with WebSocket namespace identifiers for multi-tenant applications

@WebSocketGateway(3000)
type NamespaceGateway struct {
	@Inject("namespaceService")
	namespaceService *NamespaceService
}

// === BASIC NAMESPACE ACCESS PATTERNS ===

