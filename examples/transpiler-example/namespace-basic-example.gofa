// Namespace-aware room operations
@SubscribeMessage("join_namespaced_room")
func HandleJoinNamespacedRoom(
	@MessageBody() request *NamespacedRoomRequest,
	@Namespace() namespace string,
	@Rooms() rooms []string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Create namespaced room name
	namespacedRoomName := namespace + ":" + request.RoomName
	
	// Check if already in this namespaced room
	for _, room := range rooms {
		if room == namespacedRoomName {
			// client.Emit("error", "Already in namespaced room: " + namespacedRoomName)
			return
		}
	}

	// Join the namespaced room
	// client.Join(namespacedRoomName)
	
	// client.Emit("joined_namespaced_room", map[string]interface{}{
	//     "namespace": namespace,
	//     "roomName": request.RoomName,
	//     "fullRoomName": namespacedRoomName,
	// })
}

