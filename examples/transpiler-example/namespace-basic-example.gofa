// === NAMESPACE STATISTICS PATTERNS ===

// Get namespace statistics
@SubscribeMessage("get_namespace_stats")
func HandleGetNamespaceStats(
	@Namespace() namespace string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Gather stats for current namespace
	stats := make(map[string]interface{})
	stats["namespace"] = namespace
	stats["connections"] = getNamespaceConnectionCount(namespace)
	stats["uptime"] = getNamespaceUptime(namespace)
	
	// client.Emit("namespace_stats", stats)
}

// Namespace health check
@SubscribeMessage("namespace_health")
func HandleNamespaceHealth(
	@Namespace() namespace string,
	@ConnectedSocket() client *WebSocketClient
) {
	// Check health of current namespace
	health := checkNamespaceHealth(namespace)
	
	healthResponse := map[string]interface{}{
		"namespace": namespace,
		"status":    health.Status,
		"healthy":   health.Healthy,
		"checkedAt": getCurrentTimestamp(),
	}
	
	// client.Emit("namespace_health_result", healthResponse)
}

