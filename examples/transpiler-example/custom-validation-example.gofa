@Injectable()
type UserProfileDto struct {
    // Custom validation for Social Security Number
    @Custom(isValidSSN)
    SSN string
    
    // Custom validation for credit score range
    @Custom(isValidCreditScore) 
    CreditScore int
    
    // Pattern validation combined with custom validation
    @IsLowercase()
    @Custom(isValidDomainName)
    Website string
    
    // Optional field with custom validation
    @IsOptional()
    @Custom(isValidReferralCode)
    ReferralCode string
}

@Injectable()
type ValidationService struct {
}

func (s *ValidationService) validateProfile(dto UserProfileDto) {
    // Body parameter validation will be generated automatically
    // Custom validation functions must be provided by the user
}

@Controller("/api/profile")
type ProfileController struct {
    service *ValidationService `inject:""`
}

@Post("/validate")
func (c *ProfileController) validateProfile(@Body() profile UserProfileDto) {
    c.service.validateProfile(profile)
}